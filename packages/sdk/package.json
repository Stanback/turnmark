{
  "name": "@turnmark/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Offline swim calculations, published benchmarks, and source provenance.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./engine.wasm": "./dist/generated/turnmark_wasm_bg.wasm",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conversion": {
      "types": "./dist/conversion.d.ts",
      "import": "./dist/conversion.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "import": "./dist/time.js"
    },
    "./youth": {
      "types": "./dist/youth.d.ts",
      "import": "./dist/youth.js"
    },
    "./masters": {
      "types": "./dist/masters.d.ts",
      "import": "./dist/masters.js"
    },
    "./points": {
      "types": "./dist/points.d.ts",
      "import": "./dist/points.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    },
    "./compat/masters": {
      "types": "./dist/internal/masters.d.ts",
      "import": "./dist/internal/masters.js"
    },
    "./compat/points": {
      "types": "./dist/internal/points.d.ts",
      "import": "./dist/internal/points.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-sdk.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "npm run build && node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stanback/turnmark.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Stanback/turnmark/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/Stanback/turnmark/issues"
  },
  "author": "Brianna Stanback",
  "keywords": [
    "swimming",
    "swim-times",
    "conversion",
    "wasm",
    "rust",
    "offline"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
