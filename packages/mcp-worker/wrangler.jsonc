{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "turnmark-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mcp.turnmark.app", "custom_domain": true }],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "95418001",
      "simple": { "limit": 180, "period": 60 },
    },
    {
      "name": "REQUEST_BUDGET",
      "namespace_id": "95418002",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false },
  },
}
