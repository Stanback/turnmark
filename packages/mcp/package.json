{
  "name": "@turnmark/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Read-only, offline swimming tools over MCP, powered by the Turnmark Rust SDK.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "turnmark-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stanback/turnmark.git",
    "directory": "packages/mcp"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
    "@turnmark/sdk": "0.1.0",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
