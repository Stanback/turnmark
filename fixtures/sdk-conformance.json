    {
      "id": "ncaa-rulebook-example",
      "operation": "convert",
      "input": {
        "swim": {
          "time": "2:16.71",
          "event": {
            "distance": 200,
            "stroke": "breaststroke",
            "course": "LCM"
          }
        },
        "to": "SCY",
        "table": "men"
      },
      "expected": {
        "status": "available",
        "value": {
          "time": "1:57.29",
          "seconds": 117.29,
          "hundredths": 11729,
          "factor": 0.858,
          "kind": "published",
          "event": {
            "distance": 200,
            "stroke": "breaststroke",
            "course": "SCY"
          }
        }
      },
      "source": "https://ncaaorg.s3.amazonaws.com/championships/sports/swimdive/rules/PRXSW_RulesBook.pdf#page=125",
      "rationale": "Published Appendix C example: 136.71 \u00d7 0.858 = 117.29718; drop units below hundredths."
    },
