{
  "name": "turnmark",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:sdk && vite",
    "build": "npm run build:sdk && vite build && node scripts/finish-build.mjs",
    "build:sdk": "npm run build --workspace @turnmark/sdk",
    "build:engine": "npm run build:sdk",
    "build:native:ios": "node scripts/package-ios.mjs",
    "build:native:android": "node scripts/package-android.mjs",
    "test:engine": "npm run build:sdk && node scripts/test-shared.mjs wasm",
    "prepare": "npm run build:sdk",
    "preview": "vite preview",
    "check": "npm run build:sdk && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "pretest": "npm run build:sdk",
    "test": "vitest run",
    "test:sdk:package": "npm run build:sdk && node scripts/test-sdk-package.mjs",
    "test:browser": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "data:refresh": "python3 scripts/import-standards.py",
    "data:points": "python3 scripts/import-points.py",
    "data:masters": "python3 scripts/import-masters.py",
    "format": "prettier --write . --plugin=prettier-plugin-svelte"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "description": "Your swim. Any course. A browser-only swim time converter and standards explorer.",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@turnmark/sdk": "0.1.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0"
  }
}
